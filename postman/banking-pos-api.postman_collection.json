{
  "info": {
    "_postman_id": "banking-pos-api-collection",
    "name": "Banking POS - All APIs",
    "description": "REST APIs across banking-pos microservices.\n\n**Ports (local dev):**\n| Service | Port |\n|---------|------|\n| CustomerService | 8083 |\n| AccountService | 8084 |\n| PaymentOrchestrator | 8086 |\n| BillerService | 8088 |\n| EFTService | 8089 (skeleton, no endpoints) |\n| BillPayWorkerService | 8090 |\n| EFTWorkerService | 8091 (Kafka only) |\n| AuthUser | 8094 |\n| SettlementService | Kafka only, no REST |\n\n**Auth:** Most endpoints require `Authorization: Bearer {{access_token}}` issued by AuthUser (`/api/v1/auth/login`). Set `access_token` after login.\n\n**Idempotency:** Use header `Idempotency-Key` (UUID) for create account, holds, bill pay.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "customer_base",
      "value": "http://localhost:8083"
    },
    {
      "key": "account_base",
      "value": "http://localhost:8084"
    },
    {
      "key": "payment_base",
      "value": "http://localhost:8086"
    },
    {
      "key": "biller_base",
      "value": "http://localhost:8088"
    },
    {
      "key": "auth_base",
      "value": "http://localhost:8094"
    },
    {
      "key": "billpay_worker_base",
      "value": "http://localhost:8090"
    },
    {
      "key": "external_id",
      "value": "cust-ext-001"
    },
    {
      "key": "customer_id",
      "value": "cust-ext-001"
    },
    {
      "key": "account_id",
      "value": "00000000-0000-0000-0000-000000000001"
    },
    {
      "key": "hold_id",
      "value": "00000000-0000-0000-0000-000000000002"
    },
    {
      "key": "transaction_id",
      "value": "00000000-0000-0000-0000-000000000003"
    },
    {
      "key": "payment_id",
      "value": "00000000-0000-0000-0000-000000000004"
    },
    {
      "key": "biller_id",
      "value": "00000000-0000-0000-0000-000000000005"
    },
    {
      "key": "biller_ref_num",
      "value": "BILLER-REF-001"
    },
    {
      "key": "batch_id",
      "value": "00000000-0000-0000-0000-000000000006"
    },
    {
      "key": "idempotency_key",
      "value": "idem-{{$guid}}"
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "login_email",
      "value": "customer@example.com"
    },
    {
      "key": "temporary_password",
      "value": "Temp@12345"
    }
  ],
  "item": [
    {
      "name": "Customer Service (:8083)",
      "item": [
        {
          "name": "Health",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{customer_base}}/api/v1/customers/health"
          }
        },
        {
          "name": "Create Customer",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Nguyen\",\n  \"lastName\": \"Van A\",\n  \"email\": \"nguyen.a@example.com\",\n  \"phone\": \"+84901234567\",\n  \"address\": \"123 Main St, Toronto, ON\",\n  \"externalId\": \"{{external_id}}\"\n}"
            },
            "url": "{{customer_base}}/api/v1/customers"
          }
        },
        {
          "name": "Get Customer by External ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{customer_base}}/api/v1/customers/{{external_id}}"
          }
        },
        {
          "name": "Exists by Email",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{customer_base}}/api/v1/customers/exists?email=nguyen.a@example.com",
              "host": [
                "{{customer_base}}"
              ],
              "path": [
                "api",
                "v1",
                "customers",
                "exists"
              ],
              "query": [
                {
                  "key": "email",
                  "value": "nguyen.a@example.com"
                }
              ]
            }
          }
        },
        {
          "name": "Exists by External ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{customer_base}}/api/v1/customers/{{external_id}}/exists"
          }
        },
        {
          "name": "Update Customer",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "If-Match",
                "value": "1"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+84909998877\"\n}"
            },
            "url": "{{customer_base}}/api/v1/customers/{{external_id}}"
          }
        },
        {
          "name": "Update KYC Status (VERIFIED)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kycStatus\": \"VERIFIED\"\n}"
            },
            "url": "{{customer_base}}/api/v1/customers/{{external_id}}/kyc-status"
          }
        }
      ]
    },
    {
      "name": "Account Service (:8084)",
      "item": [
        {
          "name": "Create Account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotency_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customer_id}}\",\n  \"accountType\": \"CHEQUING\",\n  \"accountSubType\": \"PERSONAL\",\n  \"status\": \"ACTIVE\",\n  \"currency\": \"CAD\",\n  \"nickname\": \"Main chequing\",\n  \"displayName\": \"Everyday\",\n  \"openingBalance\": 1000.00\n}"
            },
            "url": "{{account_base}}/api/v1/accounts"
          }
        },
        {
          "name": "Get Account",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{account_base}}/api/v1/accounts/{{account_id}}"
          }
        },
        {
          "name": "List Accounts (admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{account_base}}/api/v1/accounts?status=ACTIVE&currency=CAD",
              "host": [
                "{{account_base}}"
              ],
              "path": [
                "api",
                "v1",
                "accounts"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "ACTIVE"
                },
                {
                  "key": "currency",
                  "value": "CAD"
                }
              ]
            }
          }
        },
        {
          "name": "Get Balance",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{account_base}}/api/v1/accounts/{{account_id}}/balance"
          }
        },
        {
          "name": "Get Accounts by Customer",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{account_base}}/api/v1/customer/{{customer_id}}/accounts"
          }
        },
        {
          "name": "Update Account Status",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{account_base}}/api/v1/accounts/{{account_id}}/status?status=FROZEN",
              "host": [
                "{{account_base}}"
              ],
              "path": [
                "api",
                "v1",
                "accounts",
                "{{account_id}}",
                "status"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "FROZEN"
                }
              ]
            }
          }
        },
        {
          "name": "Get Account Owner",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{account_base}}/api/v1/accounts/{{account_id}}/owner"
          }
        },
        {
          "name": "Place Hold",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotency_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 50.00,\n  \"reason\": \"BILLPAY\",\n  \"releaseAt\": null,\n  \"idempotencyKey\": null\n}"
            },
            "url": "{{account_base}}/api/v1/accounts/{{account_id}}/holds"
          }
        },
        {
          "name": "Release Hold",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{account_base}}/api/v1/accounts/{{account_id}}/holds/{{hold_id}}/release"
          }
        },
        {
          "name": "Credit Account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "If-Match",
                "value": "1"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 100.00,\n  \"reason\": \"deposit\"\n}"
            },
            "url": "{{account_base}}/api/v1/accounts/{{account_id}}/credit"
          }
        },
        {
          "name": "Debit Account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "If-Match",
                "value": "1"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 25.00,\n  \"reason\": \"payment\"\n}"
            },
            "url": "{{account_base}}/api/v1/accounts/{{account_id}}/debit"
          }
        }
      ]
    },
    {
      "name": "Transactions (:8084)",
