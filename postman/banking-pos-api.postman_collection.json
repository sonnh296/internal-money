            }
          }
        },
        {
          "name": "Get Transaction by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{account_base}}/api/v1/transactions/{{transaction_id}}"
          }
        }
      ]
    },
    {
      "name": "Payment Orchestrator (:8086)",
      "item": [
        {
          "name": "Bill Pay (async 202)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotency_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"debtorAccountId\": \"{{account_id}}\",\n  \"billerReferenceNumber\": \"{{biller_ref_num}}\",\n  \"invoiceReference\": \"INV-2025-001\",\n  \"executionDate\": \"2025-06-01\",\n  \"amount\": {\n    \"value\": 49.99,\n    \"currency\": \"CAD\"\n  },\n  \"note\": \"Electric bill\"\n}"
            },
            "url": "{{payment_base}}/api/v1/payments/billpay"
          }
        },
        {
          "name": "Get Payment Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{payment_base}}/api/v1/payments/{{payment_id}}"
          }
        }
      ]
    },
    {
      "name": "Biller Service (:8088)",
      "item": [
        {
          "name": "Create Biller",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Hydro One\",\n  \"referenceNumber\": \"{{biller_ref_num}}\",\n  \"category\": \"Electricity\"\n}"
            },
            "url": "{{biller_base}}/api/v1/billers"
          }
        },
        {
          "name": "List Billers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{biller_base}}/api/v1/billers?limit=10&offset=0",
              "host": [
                "{{biller_base}}"
              ],
              "path": [
                "api",
                "v1",
                "billers"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            }
          }
        },
        {
          "name": "Get Biller",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{biller_base}}/api/v1/billers/{{biller_id}}"
          }
        },
        {
          "name": "Delete Biller",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{biller_base}}/api/v1/billers/{{biller_id}}"
          }
        },
        {
          "name": "Is Biller Active (registry)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{biller_base}}/api/v1/billers/{{biller_ref_num}}/active"
          }
        }
      ]
    },
    {
      "name": "Auth User (:8094)",
      "item": [
        {
          "name": "Create Internal User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{login_email}}\",\n  \"customerId\": \"{{external_id}}\",\n  \"temporaryPassword\": \"{{temporary_password}}\"\n}"
            },
            "url": "{{auth_base}}/api/v1/internal/users"
          }
        },
        {
          "name": "Login (save tokens)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{login_email}}\",\n  \"password\": \"{{temporary_password}}\"\n}"
            },
            "url": "{{auth_base}}/api/v1/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set(\"access_token\", data.access_token || \"\");",
                  "pm.collectionVariables.set(\"refresh_token\", data.refresh_token || \"\");"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Access Token",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "url": "{{auth_base}}/api/v1/auth/refresh"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set(\"access_token\", data.access_token || \"\");",
                  "pm.collectionVariables.set(\"refresh_token\", data.refresh_token || \"\");"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout (revoke refresh)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "url": "{{auth_base}}/api/v1/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Bill Pay Worker - Mock (:8090)",
      "item": [
        {
          "name": "Simulate Central1 pain.002",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{billpay_worker_base}}/api/mock/central1/pain002/{{batch_id}}"
          }
        }
      ]
    },
    {
      "name": "EFT Service (:8089) - skeleton",
      "description": "ExternalAccountController has no implemented endpoints yet. Base path: /api/v1/external-accounts",
      "item": []
    }
  ]
}
